<Window x:Class="finanzen_sql.Windows.MainWindow"
        xmlns:controls="clr-namespace:finanzen_sql.Builds"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:finanzen_sql"
        mc:Ignorable="d"
        Title="Finanzübersicht"
        Height="400"
        Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#181735">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <controls:TopBar Grid.Row="0"
                         Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="60,0,60,0">

            <StackPanel>
                <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">

                    <TextBlock Text="FinanzDodo - Deine Finanzapp" 
                       Foreground="White" 
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Bahnschrift"/>
                </StackPanel>

                <TextBlock Text="Behalte" 
                   Foreground="LightGray" 
                   FontSize="20"
                   FontWeight="Medium"
                   FontFamily="Bahnschrift"/>

                <TextBlock Text="Alles" 
                   Foreground="LightGray" 
                   FontSize="20"
                   FontWeight="Medium"
                   FontFamily="Bahnschrift"/>

                <TextBlock Text="Im Blick" 
                   Foreground="LightGray" 
                   FontSize="20"
                   FontWeight="Medium"
                   FontFamily="Bahnschrift"/>

                <TextBlock Text="Registriere oder melde dich an, um ab heute deine Finanzen jederzeit unter Kontrolle zu haben" 
                           Foreground="LightGray" 
                           FontSize="14"
                           FontWeight="Normal"
                           TextWrapping="Wrap"
                           FontFamily="Bahnschrift"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="Login" 
                        Click="LoginClick"
                        Margin="0,10,0,0"
                        Style="{StaticResource LoginButtonStyle}"/>
                <Button Content="Registrieren"
                        Margin="5,10,0,0"
                        Click="RegistrationClick"
                        Style="{StaticResource RegistrationButtonStyle}"/>
            </StackPanel>
        </StackPanel>
        <Image Source="/Images/dodo.png"
               RenderOptions.BitmapScalingMode="Fant"
               Grid.Column="1"
               Margin="10,10,10,10"
               Grid.Row="1"/>

    </Grid>
</Window>
