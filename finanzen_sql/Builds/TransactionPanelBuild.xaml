<UserControl x:Class="finanzen_sql.Builds.TransactionPanelBuild"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:finanzen_sql.Builds"
             mc:Ignorable="d"
             Height="500"
             Width="1000">
    <Grid>
        <Border Width="900"
                Padding="25"
                CornerRadius="15"
                Background="#1B1F3A"
                Margin="10">

            <Grid>
                <!--TopBar-->
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="Filter"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Foreground="LightGray"
                                   FontSize="24"/>
                        <ComboBox x:Name="CmbCategoryFilter"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  DropDownOpened="CategoryFilter_DropDownOpened"
                                  DropDownClosed="CmbFilter_DropDownClosed"
                                  Style="{StaticResource ComboBoxFilter}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Kategorie"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource StandardizedTextBlock}"/>
                        
                        <ComboBox x:Name="CmbTypeFilter"
                                  Grid.Row="0"
                                  Grid.Column="2"
                                  DropDownOpened="TypeFilter_DropDownOpened"
                                  DropDownClosed="CmbFilter_DropDownClosed"
                                  Style="{StaticResource ComboBoxFilter}"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="Typ"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource StandardizedTextBlock}"/>

                        <ComboBox x:Name="CmbRecurringFilter"
                                  Grid.Row="0"
                                  Grid.Column="3"
                                  DropDownOpened="CmbRecurringFilter_DropDownOpened"
                                  DropDownClosed="CmbFilter_DropDownClosed"
                                  Style="{StaticResource ComboBoxFilter}"/>
                        
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="Dauerauftrag"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource StandardizedTextBlock}"/>

                        <Button Content="Zurücksetzen"
                                Grid.Column="5"
                                Margin="10,0,0,0"
                                Click="ClearFiltersClick"
                                Style="{StaticResource RegistrationButtonStyle}"/>
                        </Grid>
                </StackPanel>
                
                <!--Transaction Panel-->
                <DataGrid x:Name="DataGridTransaction"
                          AlternationCount="2"
                          AutoGenerateColumns="False"
                          HorizontalAlignment="Center"
                          Style="{StaticResource DataGridTransaction}"
                          ColumnHeaderStyle="{StaticResource DataGridTransactionColumnHeaderStyle}"
                          RowStyle="{StaticResource DataGridTransactionRowStyle}">
                    
                    <!--Table definiton-->
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Aktionen">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit"
                                                Margin="0,0,5,0"
                                                Background="#3A4A7A"
                                                Foreground="White"
                                                Tag="{Binding Id}"
                                                Click="EditEntryClick"/>

                                        <Button Content="Delete"
                                                Background="Red"
                                                Foreground="White"
                                                Tag="{Binding Id}"
                                                Click="DeleteEntryClick"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!--Coloring the amount column-->
                        <DataGridTemplateColumn Header="Betrag">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Amount}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="ForestGreen"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CategoryType}" Value="Ausgabe">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Notiz" Binding="{Binding Description}"/>
                        <DataGridTextColumn Header="Kategorie" Binding="{Binding CategoryName}"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                        <DataGridTextColumn Header="Dauerauftrag" Binding="{Binding IsRecurring}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>
        
        <Grid VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="0,0,0 40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnPrevious"
                    Grid.Column="0"
                    Content="Zurück"
                    Click="BtnPreviousClick"
                    Margin="0,0,10,0"
                    Style="{StaticResource LoginButtonStyle}"/>
            <Button x:Name="BtnNext"
                    Grid.Column="1"
                    Content="Vor"
                    Click="BtnNextClick"
                    Style="{StaticResource LoginButtonStyle}"/>
        </Grid>
    </Grid>
</UserControl>
