<UserControl x:Class="finanzen_sql.Builds.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:finanzen_sql.Builds"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White"/>
        <Border Grid.Column="1" Background="White"/>

        <Grid Background="#0F0F2D"
          Grid.ColumnSpan="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="Homepage"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Click="RouteToHomepageClick"
                    Style="{StaticResource HomepageButtonStyle}"/>    

            <TextBlock Text="Einnahmen" 
                   Grid.Column="2"
                   Style="{StaticResource TopbarTextBlock}"/>

            <TextBlock Text="Ausgaben" 
                   Grid.Column="3"
                   Style="{StaticResource TopbarTextBlock}"/>

            <Button Content="X"
                Foreground="LightGray"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="10"
                Click="CloseClick"
                Cursor="Hand"/>
        </Grid>
    </Grid>
</UserControl>
