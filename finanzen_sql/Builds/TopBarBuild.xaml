<UserControl x:Class="finanzen_sql.Builds.TopBarBuild"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:finanzen_sql.Builds"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White"/>
        <Border Grid.Column="1" Background="White"/>

        <Grid Background="#0F0F2D"
          Grid.ColumnSpan="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="Homepage"
                    FontSize="14"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Click="RouteToHomepageClick"
                    Style="{StaticResource HomepageButtonStyle}"/>

            <Button Content="Übersicht"
                    FontSize="14"
                    Grid.Column="2"
                    Click="CheckIfFinanzDodo"
                    Style="{StaticResource TopBarButtonStyle}"/>

            <Button Content="Transaktionen"
                    FontSize="14"
                    Grid.Column="3"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0"
                    Click="CheckIfFinanzDodo"
                    Style="{StaticResource TopBarButtonStyle}"/>

            <Button Content="X"
                    FontSize="14"
                    Grid.Column="11"
                    Click="CloseClick"
                    Style="{StaticResource CloseButtonStyle}"/>
        </Grid>
    </Grid>
</UserControl>
