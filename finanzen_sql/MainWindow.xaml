<Window x:Class="finanzen_sql.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:finanzen_sql"
        mc:Ignorable="d"
        Title="Finanzübersicht" Height="450" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#181735">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <Grid Background="#0F0F2D"
              Grid.ColumnSpan="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="47*"/>
                <ColumnDefinition Width="19*"/>
                <ColumnDefinition Width="103*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="62*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Übersicht" 
                       Foreground="LightGray" 
                       FontSize="12"
                       FontWeight="Bold"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Height="19" Width="58"
                       FontFamily="Bahnschrift" Grid.ColumnSpan="2"/>

            <TextBlock Text="Einnahmen" 
                       Foreground="LightGray" 
                       FontSize="12"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Height="19" Width="67"
                       FontFamily="Bahnschrift" Grid.ColumnSpan="3" Margin="44,0,0,0"/>

            <TextBlock Text="Ausgaben" 
                       Foreground="LightGray" 
                       FontSize="12"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Height="19" Width="53"
                       FontFamily="Bahnschrift" Margin="46,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="60,0,60,0">
            <StackPanel>
                    <StackPanel Orientation="Horizontal"
                Margin="0,0,0,20">

        <Image Width="50" Height="50"
               Source="/images/coin.png"
               RenderOptions.BitmapScalingMode="Fant"/>

        <TextBlock Text="Finanzen" 
                   Foreground="LightGray" 
                   FontSize="20"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="10,0,0,0"
                   FontFamily="Bahnschrift"/>
    </StackPanel>

    <TextBlock Text="Behalte" 
               Foreground="LightGray" 
               FontSize="25"
               FontWeight="Medium"
               FontFamily="Bahnschrift"/>

    <TextBlock Text="Alles" 
               Foreground="LightGray" 
               FontSize="25"
               FontWeight="Medium"
               FontFamily="Bahnschrift"/>

    <TextBlock Text="Im Blick" 
               Foreground="LightGray" 
               FontSize="25"
               FontWeight="Medium"
               FontFamily="Bahnschrift"/>

    <TextBlock Text="Registriere oder melde dich an, um ab heute deine Finanzen jederzeit unter Kontrolle zu haben" 
               Foreground="LightGray" 
               FontSize="14"
               FontWeight="Normal"
               TextWrapping="Wrap"
               FontFamily="Bahnschrift"
               Margin="0,10,0,0"/>
</StackPanel>

<StackPanel Orientation="Horizontal">
                <Button Content="Login" 
            Style="{StaticResource LoginButtonStyle}"
            Margin="0,5,0,0"/>
            </StackPanel>
            </StackPanel>

           

    </Grid>
</Window>
